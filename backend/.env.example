# ────────────────────────────────────────────────────────────────
# AI Flight Assistant — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control. Placeholder values only below.
# ────────────────────────────────────────────────────────────────

# ────────────────────────────────────────────────────────────────
# Application
# ────────────────────────────────────────────────────────────────
APP_NAME=Flight Assistant AI
APP_VERSION=1.0.0

# Environment: development | testing | production
#   development — local SQLite (default, safe to omit)
#   testing     — isolated temporary SQLite via TEST_DATABASE_URL
#   production  — Neon PostgreSQL; enables fail-fast guards (strong JWT,
#                 explicit CORS, no DEBUG, PostgreSQL-only database)
ENVIRONMENT=development
DEBUG=false

# ────────────────────────────────────────────────────────────────
# Database
# ────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT — async SQLite via aiosqlite (also the code default).
DATABASE_URL=sqlite+aiosqlite:///./flight_assistant.db

# PRODUCTION — Neon / PostgreSQL with the asyncpg driver. Set this in the
# deployment environment only; never commit a real credential.
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
#
# Notes:
#  - Both `sqlite+aiosqlite:///...` and `postgresql+asyncpg://...` are native.
#  - A legacy psycopg2-style `postgresql://...` URL is also accepted and is
#    translated to `postgresql+asyncpg://...` at import time.
#  - sslmode/channel_binding query params are normalized away for asyncpg,
#    which negotiates TLS by default.

# AUTOMATED TESTS — isolated temporary SQLite file. NEVER set this to the
# production/development database; database.database refuses non-SQLite and
# DATABASE_URL-identical values.
TEST_DATABASE_URL=

# ────────────────────────────────────────────────────────────────
# Authentication / JWT
# ────────────────────────────────────────────────────────────────
# Production requires a strong secret (>= 32 chars) and fails fast otherwise.
JWT_SECRET_KEY=replace-with-a-long-random-secret
# Comma/space-free base64 or hex is recommended. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ────────────────────────────────────────────────────────────────
# CORS / Frontend
# ────────────────────────────────────────────────────────────────
# Comma-separated explicit origins. Local default; production must list the
# real frontend domain(s) and must NOT use "*".
ALLOWED_ORIGINS=http://localhost:3000
# Production example (replace with the deployed frontend URL):
# ALLOWED_ORIGINS=https://your-frontend-domain.example

# ────────────────────────────────────────────────────────────────
# AI Provider
# ────────────────────────────────────────────────────────────────
# Choose: gemini | groq
DEFAULT_PROVIDER=gemini

# Gemini (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama3-8b-8192

# ────────────────────────────────────────────────────────────────
# Sessions
# ────────────────────────────────────────────────────────────────
SESSION_DB_PATH=./sessions.db

# Tracing (set false to enable Agents SDK tracing)
DISABLE_TRACING=true

# ────────────────────────────────────────────────────────────────
# Stripe — OPTIONAL payment module.
# The app runs fully WITHOUT these. When present, Stripe checkout + webhook
# payment flow is enabled; booking confirmation still works directly without
# payment (PENDING -> CONFIRMED). Leave blank to disable Stripe.
# ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=