# ────────────────────────────────────────────────────────────────
# AI Flight Assistant — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ────────────────────────────────────────────────────────────────

# Application
APP_NAME=Flight Assistant AI
APP_VERSION=1.0.0
DEBUG=false

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=sqlite+aiosqlite:///./flight_assistant.db

# AI Provider — choose: gemini | groq
DEFAULT_PROVIDER=gemini

# Gemini (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama3-8b-8192

# Sessions
SESSION_DB_PATH=./sessions.db

# Tracing (set false to enable Agents SDK tracing)
DISABLE_TRACING=true

# ────────────────────────────────────────────────────────────────
# Stripe — OPTIONAL payment module.
# The app runs fully WITHOUT these. When present, Stripe checkout + webhook
# payment flow is enabled; booking confirmation still works directly without
# payment (PENDING -> CONFIRMED). Leave blank to disable Stripe.
# ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
